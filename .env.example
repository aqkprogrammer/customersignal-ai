# ---- Core ----
ENVIRONMENT=development
APP_SECRET_KEY=change-me-to-a-random-64-char-string
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://localhost:8000   # where the Next.js server proxies /api/v1/* (read at build time)
API_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# ---- Data stores ----
DATABASE_URL=postgresql+asyncpg://localhost/customersignal
REDIS_URL=redis://localhost:6379/0
JOBS_INLINE=false            # true = run jobs in the API process (dev only, no worker needed)
JOBS_QUEUE_NAME=customersignal:jobs   # dedicated arq queue; keep unique if Redis is shared

# ---- Auth (built-in FastAPI auth; Supabase optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=        # redirect URI: ${NEXT_PUBLIC_APP_URL}/api/v1/auth/google/callback
EMAIL_VERIFICATION_REQUIRED=true
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Admin bootstrap (python -m app.scripts.bootstrap_admin) ----
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_SECRET=

# ---- AI providers (none set = built-in keyword engine) ----
AI_PROVIDER=auto             # auto | anthropic | openai | heuristic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# ---- Billing ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=       # webhook URL: ${NEXT_PUBLIC_APP_URL}/api/v1/billing/webhook
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Email ----
RESEND_API_KEY=              # unset = emails are logged to the API console
EMAIL_FROM=CustomerSignal AI <noreply@yourdomain.com>

# ---- Storage (unset = ./storage on local disk) ----
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=

# ---- Frontend build ----
BUILD_STANDALONE=          # set to 1 for Docker (Next.js standalone output)
